RING_API_BASE_URL=http://127.0.0.1:8787
RING_ACCESS_TOKEN=dev-token
RING_WEBHOOK_SECRET=dev-hmac-key
RING_POLL_SECONDS=15
SENSOR_STALE_MINUTES=60
VALVE_CLOSE_SECONDS=4
VERIFY_QUIET_SECONDS=60
APPROVAL_TIMEOUT_SECONDS=120
HOME_TIMEZONE=Asia/Kolkata

# Module 1: Bedrock grounded reports (optional). Leave BEDROCK_MODEL_ID empty, or have no
# AWS credentials, and Guardian uses the template report with no errors.
# Credentials come from the standard AWS chain (env vars, ~/.aws, SSO, instance role).
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
BEDROCK_TIMEOUT_SECONDS=8

# Module 2: Alexa+ MCP server + OAuth. In production every value below is required.
ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
SESSION_SECRET=
ALEXA_OAUTH_CLIENT_ID=guardian-alexa
ALEXA_OAUTH_CLIENT_SECRET=
ALEXA_OAUTH_REDIRECT_URIS=
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
DEV_MCP_TOKEN=
